# Disabled Javascript unit tests (npm run test)
# due to https://github.com/oapicf/endoflife.date-api-clients/issues/1
#
# NOTE: test-javascript's default recipe (in Makefile) still runs `npm run test`
# after this hook, since a hook can't skip its caller's remaining recipe lines.
# So instead of trying to bypass that `npm run test` line, we neutralise it:
# swap the generated client's own test script for a no-op, so when the default
# recipe calls it again later it just succeeds instead of failing.
x-pre-test-javascript:
	cd clients/javascript/generated/ && \
	  npm pkg set scripts.test="echo 'Skipped due to https://github.com/oapicf/endoflife.date-api-clients/issues/1'"

.PHONY: x-pre-test-javascript